<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <!-- For IDE0005 (unneeded usings), which needs it; the tests don't need doc comments (CS1591) -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Test names separate the member and the case with underscores (Decode_ReadsEveryFormat) -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- The allocation tests read GC.GetAllocatedBytesForCurrentThread. A background GC can retire a
             thread's allocation buffer and count what was left of it as allocated, so a test that
             allocated nothing fails with up to 8 KB; blocking GCs count correctly -->
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="4.0.3" />
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <None Update="TestData\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\src\DotGame.AudioCodecs.csproj" />
    </ItemGroup>

</Project>
